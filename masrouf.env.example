# Copy to masrouf.env and fill in. masrouf.env is gitignored.
#
# Publishable (formerly "anon") key ONLY — never the service_role key.
# The publishable key is compiled into the app binary either way; RLS is what
# actually protects the data. The service_role key bypasses RLS completely.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<publishable key>
REQUIRE_EMAIL_CONFIRMATION=true
AUTH_REDIRECT_URL=io.masrouf://auth-callback
BASE_CURRENCY=TND
